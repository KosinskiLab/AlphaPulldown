# Phase 0 kernel benchmark: every path, pin and setting in one place.
# Sourced by every job script; override any value by exporting it before submit.sh.

# Code (this directory) and where results go. Nothing is written inside the repo.
CODE=${CODE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}
BENCH=${BENCH:-/scratch/dima/kernel_bench_phase0}

# Pinned sources.
UBM_REPO=https://github.com/anthropics/uplifting-biomolecular-modeling.git
UBM_COMMIT=f4f62fa6592ae4938d49b1757bea0cfeff9f468e   # initial public release, 2026-09-17
COLABFOLD_VERSION=1.6.3                                # first release with correct fused kernels (1.6.2's were wrong)
COLABFOLD_JAX=0.11.2                                   # jax[cuda12] for the ColabFold 1.6.3 image (colabfold allows >=0.6.2,<0.12)
AP_VERSION=2.9.0                                       # kosinskilab/alphafold2 and alphafold3 images

# Images (built or pulled by images/build_images.sbatch).
SIF_AP_AF2=$BENCH/images/alphapulldown_af2_${AP_VERSION}.sif
SIF_AP_AF3=$BENCH/images/alphapulldown_af3_${AP_VERSION}.sif
SIF_CF163=$BENCH/images/colabfold_${COLABFOLD_VERSION}.sif
SIF_KIT=$BENCH/images/colabfold_kit_${UBM_COMMIT:0:8}.sif

# Inputs. Copied into $BENCH/inputs by make_inputs.sbatch so later edits upstream cannot move them.
SRC_FEATURES=/scratch/dima/af2_mmseqs_bench/native/features        # AF2 pickles, native jackhmmer pipeline
SRC_NATIVES=/scratch/dima/af2_mmseqs_bench/complexes/native_structures
SRC_ACCURACY_FOLDS=/scratch/dima/af2_mmseqs_bench/inputs/complex_folds.txt
AF2_DATA=/g/alphafold/AlphaFold_DBs/2.3.2                          # AlphaPulldown --data_directory (params/ inside)
AF3_WEIGHTS=/g/alphafold/af3                                       # DeepMind AF3 weights (af3.bin)
DOCKQ=/scratch/dima/af2_mmseqs_bench/dockq_venv/bin/DockQ
HOST_PY=/scratch/dima/af2_mmseqs_bench/dockq_venv/bin/python       # host python with numpy, for collect.py

# Prediction settings shared by every AF2 arm: one model, fixed work, no templates, no relax.
NUM_RECYCLE=${NUM_RECYCLE:-3}       # AlphaPulldown's default; early stopping is disabled in every arm
REPS=${REPS:-3}                     # per fold and process: rep 1 compiles, reps 2.. are timed
AF3_REPS=${AF3_REPS:-2}
SEED=${SEED:-0}

# One environment for every arm: no unified memory, allocator in growth mode so nvidia-smi
# reads what is used, not a preallocated pool, and JAX_PLATFORMS=cuda so a node whose CUDA
# cannot start fails the arm instead of silently timing jax's CPU fallback (jax 0.5.3 falls back).
MEM_ENV="--env TF_FORCE_UNIFIED_MEMORY=0 --env XLA_PYTHON_CLIENT_MEM_FRACTION=0.95 --env XLA_PYTHON_CLIENT_PREALLOCATE=false --env JAX_PLATFORMS=cuda"
# The AF3 image's jax (0.9.1) takes the fraction as XLA_CLIENT_MEM_FRACTION, which the image
# already sets; given both names its CUDA plugin refuses to start, leaving only the CPU.
MEM_ENV_AF3="--env TF_FORCE_UNIFIED_MEMORY=0 --env XLA_CLIENT_MEM_FRACTION=0.95 --env XLA_PYTHON_CLIENT_PREALLOCATE=false --env JAX_PLATFORMS=cuda"

# Nodes to keep out. gpu39 (H100) and gpu40 (L40S), gpu-el10's two large GPU nodes, run a
# kernel module (610.43.02, built 2026-09-23) that does not match their user-space driver
# (615.71): NVML and CUDA cannot start. Set EXCLUDE_NODES= once they are rebooted.
EXCLUDE_NODES=${EXCLUDE_NODES-gpu39,gpu40}

# GPU label -> partition, gres, walltime for one arm's speed ladder, kit --config.
# Queue state on 2026-10-01: gpu-el10's H100 (gpu39) and L40S (gpu40) nodes are broken (see
# EXCLUDE_NODES), its A40s and the test partition's 3090s start within minutes, gpu-training's
# H100s estimate ~11 days and gpu-el8 (A100, H100, L40S, 3090, RTX Pro 6000) two to three weeks;
# B200 (bgx1) is reserved and transform refuses jobs. Where a card lists several partitions, arms
# can land on different models of it (H100 SXM vs PCIe): collect.py only forms a speedup between
# runs on the same GPU model.
gpu_partition() {
  case $1 in
    # gpu-training cannot be listed with other partitions (it is set in our SLURM association);
    # its hgx nodes are H100 SXM 80 GB, the class Anthropic measured on, and queue soonest.
    h100) echo gpu-training ;; l40s) echo gpu-el10,gpu-el8 ;; a40) echo gpu-el10 ;;
    3090) echo test,gpu-el8 ;; *) echo gpu-el8 ;;
  esac
}
gpu_gres() {
  case $1 in
    h100) echo gpu:H100:1 ;; l40s) echo gpu:L40s:1 ;; a40) echo gpu:nvidia_a40:1 ;;
    3090) echo gpu:3090:1 ;; a100) echo gpu:A100:1 ;; rtx6000) echo gpu:nvidia_rtx_pro_6000_blackwell_server_edition:1 ;;
    *) echo "unknown gpu label $1" >&2; return 1 ;;
  esac
}
gpu_walltime() { case $1 in 3090|a40) echo 05:00:00 ;; l40s|a100) echo 03:30:00 ;; *) echo 02:30:00 ;; esac; }
kit_config() { case $1 in h100) echo h100 ;; *) echo a100 ;; esac; }   # the two files differ only in a label

ALL_GPUS="a40 3090 h100"              # start now (a40, 3090) and the reference card (h100, queues ~11 days)
SLOW_QUEUE_GPUS="l40s a100 rtx6000"   # sm_89, sm_80, sm_120 on gpu-el8: submit separately, `submit.sh full l40s a100 rtx6000`
AF2_ARMS="ap_stock cf163_stock cf163_fast kit_off kit_exact kit_fast"
